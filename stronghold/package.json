{
  "name": "stronghold",
  "version": "0.1.0",
  "private": true,
  "description": "Visitor management for the front desk of one building. Runs entirely in the browser.",
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test test/core/*.test.mjs",
    "test:e2e": "node scripts/build.mjs && node --test test/e2e/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
